{%- comment -%}
  One framed photo for the "Framed photo collage" section. Accepts: block
{%- endcomment -%}
<li
  class="ugc-gallery__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  style="--accent: {{ block.settings.accent }};"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.link != blank -%}
    <a href="{{ block.settings.link }}" target="_blank" rel="noopener">
  {%- endif -%}
  {%- if block.settings.image != blank -%}
    {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 25vw, 50vw' }}
  {%- else -%}
    <span class="ugc-gallery__placeholder">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</span>
  {%- endif -%}
  {%- if block.settings.link != blank -%}
    </a>
  {%- endif -%}
</li>

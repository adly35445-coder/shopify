{%- comment -%}
  Thin line icons for skincare ingredients.
  Accepts: name (string) - drop, leaf or sun
{%- endcomment -%}
<svg class="brand-icon" width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
  {%- case name -%}
    {%- when 'drop' -%}
      <path d="M20 5c6 8 10 13 10 18a10 10 0 0 1-20 0c0-5 4-10 10-18z"/><path d="M15 24a5 5 0 0 0 5 5"/>
    {%- when 'leaf' -%}
      <path d="M8 32C8 16 18 8 33 7c0 15-9 25-25 25z"/><path d="M8 32 24 16"/>
    {%- when 'sun' -%}
      <circle cx="20" cy="20" r="6"/><path d="M20 5v4M20 31v4M5 20h4M31 20h4M9.4 9.4l2.8 2.8M27.8 27.8l2.8 2.8M9.4 30.6l2.8-2.8M27.8 12.2l2.8-2.8"/>
  {%- endcase -%}
</svg>

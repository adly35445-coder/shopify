{{ 'section-hero-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hero-slider.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #HeroSlider-{{ section.id }} {
    --hero-height-mobile: {{ section.settings.height_mobile }}vh;
    --hero-height-desktop: {{ section.settings.height_desktop }}vh;
    --hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hero-duration: {{ section.settings.speed }}s;
  }
{%- endstyle -%}

<hero-slider
  id="HeroSlider-{{ section.id }}"
  class="hero-slider{% if section.settings.zoom %} hero-slider--zoom{% endif %}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.speed }}"
  role="region"
  aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div class="hero-slider__track">
    {%- for block in section.blocks -%}
      <div
        class="hero-slider__slide color-{{ block.settings.color_scheme }}{% if forloop.first %} is-active{% endif %} hero-slider__slide--{{ block.settings.text_position }}"
        role="group"
        aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
        aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
        {% unless forloop.first %}
          aria-hidden="true"
        {% endunless %}
        {{ block.shopify_attributes }}
      >
        <div class="hero-slider__media">
          {%- if block.settings.image != blank -%}
            {%- liquid
              assign loading = 'lazy'
              assign fetchpriority = 'auto'
              if forloop.first
                assign loading = 'eager'
                assign fetchpriority = 'high'
              endif
            -%}
            {%- if block.settings.image_mobile != blank -%}
              <picture>
                <source
                  media="(max-width: 749px)"
                  srcset="{{ block.settings.image_mobile | image_url: width: 750 }} 750w, {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w"
                >
                {{
                  block.settings.image
                  | image_url: width: 2400
                  | image_tag: widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', loading: loading, fetchpriority: fetchpriority, alt: block.settings.heading
                }}
              </picture>
            {%- else -%}
              {{
                block.settings.image
                | image_url: width: 2400
                | image_tag: widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', loading: loading, fetchpriority: fetchpriority, alt: block.settings.heading
              }}
            {%- endif -%}
          {%- else -%}
            <div class="hero-slider__placeholder" style="--accent: {{ block.settings.accent }}; --disc: {{ block.settings.mock_cap }}">
              {%- if block.settings.mock_kind != 'none' -%}
                <div class="hero-slider__mock">
                  <span class="hero-slider__disc"></span>
                  {%- render 'product-mock', kind: block.settings.mock_kind, cap: block.settings.mock_cap, body: block.settings.mock_body, ink: block.settings.mock_ink, label: block.settings.mock_label, size: 'lg' -%}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        <div class="hero-slider__content page-width">
          <div class="hero-slider__box">
            {%- if block.settings.subheading != blank -%}
              <p class="hero-slider__eyebrow" style="--d: 0.1s">{{ block.settings.subheading }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="hero-slider__heading h0" style="--d: 0.25s">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="hero-slider__text rte" style="--d: 0.4s">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <div class="hero-slider__buttons" style="--d: 0.55s">
                <a
                  {% if block.settings.button_link != blank %}
                    href="{{ block.settings.button_link }}"
                  {% else %}
                    role="link" aria-disabled="true"
                  {% endif %}
                  class="button button--primary"
                >
                  {{- block.settings.button_label | escape -}}
                </a>
                {%- if block.settings.button_label_2 != blank -%}
                  <a
                    {% if block.settings.button_link_2 != blank %}
                      href="{{ block.settings.button_link_2 }}"
                    {% else %}
                      role="link" aria-disabled="true"
                    {% endif %}
                    class="button button--secondary"
                  >
                    {{- block.settings.button_label_2 | escape -}}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="hero-slider__controls">
      <button type="button" class="hero-slider__arrow hero-slider__arrow--prev" name="previous" aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}">
        <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
      </button>
      <div class="hero-slider__dots">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="hero-slider__dot{% if forloop.first %} is-active{% endif %}"
            data-index="{{ forloop.index0 }}"
            aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
          >
            <span class="hero-slider__dot-fill"></span>
          </button>
        {%- endfor -%}
      </div>
      <button type="button" class="hero-slider__arrow hero-slider__arrow--next" name="next" aria-label="{{ 'sections.slideshow.next_slideshow' | t }}">
        <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
      </button>
    </div>
  {%- endif -%}
</hero-slider>

{% schema %}
{
  "name": "Hero slider (animated)",
  "tag": "section",
  "class": "section section-hero-slider",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "accessibility_label", "label": "Slider description (accessibility)", "default": "عروض 4M" },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "speed", "min": 3, "max": 10, "step": 1, "unit": "s", "label": "Change slide every", "default": 6 },
    { "type": "checkbox", "id": "zoom", "label": "Slow zoom on images", "default": true },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Image darkening", "default": 15 },
    { "type": "range", "id": "height_desktop", "min": 50, "max": 100, "step": 5, "unit": "vh", "label": "Height on desktop", "default": 85 },
    { "type": "range", "id": "height_mobile", "min": 50, "max": 100, "step": 5, "unit": "vh", "label": "Height on mobile", "default": 75 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (desktop)", "info": "Wide image, 1920 × 1080 px or larger" },
        { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile, optional)", "info": "Tall image, 1080 × 1350 px" },
        { "type": "color", "id": "accent", "label": "Placeholder color (shown until you add an image)", "default": "#F8F2EB" },
        {
          "type": "select",
          "id": "mock_kind",
          "label": "Drawn product (shown until you add an image)",
          "options": [
            { "value": "bottle", "label": "Bottle" },
            { "value": "jar", "label": "Jar" },
            { "value": "none", "label": "None" }
          ],
          "default": "bottle"
        },
        { "type": "color", "id": "mock_cap", "label": "Drawn product cap color", "default": "#E85D0F" },
        { "type": "color", "id": "mock_body", "label": "Drawn product body color", "default": "#FFFFFF" },
        { "type": "color", "id": "mock_ink", "label": "Drawn product text color", "default": "#2B2420" },
        { "type": "text", "id": "mock_label", "label": "Drawn product label", "default": "Sunscreen" },
        { "type": "text", "id": "subheading", "label": "Small text above heading", "default": "4M Cosmetics" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "بشرتك تستحق الأفضل" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>عناية يومية بتركيبات آمنة ومدروسة</p>" },
        { "type": "text", "id": "button_label", "label": "Button 1 label", "default": "تسوّقي الآن" },
        { "type": "url", "id": "button_link", "label": "Button 1 link" },
        { "type": "text", "id": "button_label_2", "label": "Button 2 label" },
        { "type": "url", "id": "button_link_2", "label": "Button 2 link" },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text position",
          "options": [
            { "value": "start", "label": "Start (right in Arabic)" },
            { "value": "center", "label": "Center" },
            { "value": "end", "label": "End (left in Arabic)" }
          ],
          "default": "start"
        },
        { "type": "color_scheme", "id": "color_scheme", "label": "Text color scheme", "default": "scheme-1" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slider (animated)",
      "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}

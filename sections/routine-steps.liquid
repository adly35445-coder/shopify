{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="brand-heading center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="brand-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="brand-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <ol class="routine-steps">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        <li
          class="routine-step{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          style="--accent: {{ block.settings.accent }};{% if settings.animations_reveal_on_scroll %} --animation-order: {{ forloop.index }};{% endif %}"
          {{ block.shopify_attributes }}
        >
          <span class="routine-step__number">{{ forloop.index }}</span>
          <div class="routine-step__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {%- elsif product != blank and product.featured_media != blank -%}
              {{ product.featured_media | image_url: width: 500 | image_tag: loading: 'lazy', alt: product.title }}
            {%- else -%}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <h3 class="routine-step__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="routine-step__text">{{ block.settings.text }}</p>
          {%- endif -%}
          {%- if product != blank -%}
            <a href="{{ product.url }}" class="routine-step__link link underlined-link">{{ product.title }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.button_label != blank -%}
      <div class="center routine-steps__cta">
        <a
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
          class="button button--primary"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Routine steps",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "روتين 4M" },
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "روتينك اليومي في 3 خطوات" },
    { "type": "text", "id": "subtitle", "label": "Subheading", "default": "بسيط، سريع، ونتيجته باينة" },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "اشتري الروتين كامل" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 60 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Step name", "default": "تنظيف" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "product", "id": "product", "label": "Product (optional)" },
        { "type": "image_picker", "id": "image", "label": "Image (optional, overrides product image)" },
        { "type": "color", "id": "accent", "label": "Accent color", "default": "#E85D0F" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Routine steps",
      "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }]
    }
  ]
}
{% endschema %}

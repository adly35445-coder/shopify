{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="brand-heading center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="brand-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>

    <ul class="reviews" tabindex="0" aria-label="{{ section.settings.title | strip_html | escape }}">
      {%- for block in section.blocks -%}
        <li class="review" {{ block.shopify_attributes }}>
          <div class="review__stars" aria-label="{{ block.settings.rating }} / 5">
            {%- for i in (1..5) -%}
              <span class="review__star{% if i > block.settings.rating %} review__star--off{% endif %}" aria-hidden="true">★</span>
            {%- endfor -%}
          </div>
          <blockquote class="review__quote">{{ block.settings.quote }}</blockquote>
          <div class="review__author">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', class: 'review__avatar', alt: block.settings.name }}
            {%- else -%}
              <span class="review__avatar review__avatar--initial" aria-hidden="true">{{ block.settings.name | slice: 0 }}</span>
            {%- endif -%}
            <div>
              <p class="review__name">{{ block.settings.name }}</p>
              {%- if block.settings.product != blank -%}
                <p class="review__product">{{ block.settings.product }}</p>
              {%- endif -%}
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Customer reviews",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "آراء عملائنا" },
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "جرّبوا 4M وقالوا" },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-5" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 60 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Stars", "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Review", "default": "اكتبي هنا رأي العميلة في المنتج." },
        { "type": "text", "id": "name", "label": "Customer name", "default": "اسم العميلة" },
        { "type": "text", "id": "product", "label": "Product name (optional)" },
        { "type": "image_picker", "id": "image", "label": "Photo (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer reviews",
      "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }]
    }
  ]
}
{% endschema %}

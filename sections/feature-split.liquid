{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient pattern-{{ section.settings.pattern }} edge-{{ section.settings.top_edge }} section-{{ section.id }}-padding">
  <div class="feature-split feature-split--{{ section.settings.layout }} feature-split--heading-{{ section.settings.heading_style }}{% if section.settings.layout == 'text_first' %} feature-split--reverse{% endif %}{% if section.settings.full_width == false %} page-width{% endif %}">
    <div
      class="feature-split__media{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
      style="--accent: {{ section.settings.accent }};"
    >
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1800', sizes: '(min-width: 750px) 50vw, 100vw', alt: section.settings.heading
        }}
      {%- elsif section.settings.mock_kind != 'none' -%}
        {%- if section.settings.button_tint != blank -%}
          <span class="feature-split__glow" style="--glow: {{ section.settings.button_tint }}" aria-hidden="true"></span>
        {%- endif -%}
        {%- render 'product-mock',
          kind: section.settings.mock_kind,
          cap: section.settings.mock_cap,
          body: section.settings.mock_body,
          ink: section.settings.mock_ink,
          label: section.settings.mock_label
        -%}
      {%- endif -%}
      {%- if section.settings.badge != blank -%}
        <span class="feature-split__badge">{{ section.settings.badge }}</span>
      {%- endif -%}
    </div>

    <div class="feature-split__content{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="brand-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="feature-split__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="feature-split__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="feature-split__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
          class="{% if section.settings.button_style == 'link' %}brand-link{% else %}button button--primary{% endif %}{% if section.settings.button_tint != blank %} has-tint" style="--tint: {{ section.settings.button_tint }}{% endif %}"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature (image + text)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "mock_kind",
      "label": "Drawn product (shown until you add an image)",
      "options": [
        { "value": "bottle", "label": "Bottle" },
        { "value": "jar", "label": "Jar" },
        { "value": "none", "label": "None" }
      ],
      "default": "bottle"
    },
    { "type": "color", "id": "accent", "label": "Image background color", "default": "#F3E9DD" },
    { "type": "color", "id": "mock_cap", "label": "Drawn product cap color", "default": "#E85D0F" },
    { "type": "color", "id": "mock_body", "label": "Drawn product body color", "default": "#FFFFFF" },
    { "type": "color", "id": "mock_ink", "label": "Drawn product text color", "default": "#2B2420" },
    { "type": "text", "id": "mock_label", "label": "Drawn product label", "default": "Sunscreen" },
    { "type": "text", "id": "badge", "label": "Badge on image", "default": "وصل جديد" },
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "NEWLY ARRIVED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "حمايتك اليومية" },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading style",
      "options": [
        { "value": "bold", "label": "Bold, colored" },
        { "value": "script", "label": "Handwritten" }
      ],
      "default": "bold"
    },
    { "type": "text", "id": "subheading", "label": "Line under heading (italic)" },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h0",
      "label": "Heading size"
    },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>اكتب هنا وصف قصير للمنتج</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "اكتشفيه" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "button_tint", "label": "Button colour on tap", "info": "Product colour the button turns when tapped" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "button", "label": "Button" },
        { "value": "link", "label": "Text link with arrow" }
      ],
      "default": "button"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "image_first", "label": "Image first" },
        { "value": "text_first", "label": "Text first" },
        { "value": "overlay", "label": "Text over image" }
      ],
      "default": "image_first"
    },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true },
    { "type": "select", "id": "pattern", "label": "Background pattern", "default": "none", "options": [{ "value": "none", "label": "None" }, { "value": "sparkles", "label": "Sparkles" }, { "value": "florals", "label": "Florals" }, { "value": "leaves", "label": "Leaves" }, { "value": "circles", "label": "Circles" }, { "value": "diamonds", "label": "Diamonds" }, { "value": "chevrons", "label": "Chevrons" }, { "value": "waves", "label": "Waves" }, { "value": "scallops", "label": "Scallops" }, { "value": "damask", "label": "Damask" }, { "value": "fleur", "label": "Fleur" }, { "value": "dots", "label": "Dots" }, { "value": "stars8", "label": "Stars8" }, { "value": "stars8-light", "label": "Stars8 light" }] },
    { "type": "select", "id": "top_edge", "label": "Top edge", "default": "none", "options": [{ "value": "none", "label": "Straight" }, { "value": "wave", "label": "Wave" }] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 0 }
  ],
  "presets": [{ "name": "Feature (image + text)" }]
}
{% endschema %}
